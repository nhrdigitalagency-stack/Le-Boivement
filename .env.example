# ============================================================================
# LE BOIVEMENT — VARIABLES D'ENVIRONNEMENT (SANS SECRETS)
# ============================================================================

# URL publique de l'application
APP_URL="http://localhost:3000"

# Mode d'exécution : "demo" ou "production"
VITE_APP_MODE="demo"

# Sanity.io CMS & Base de données (Configuration Serveur)
SANITY_PROJECT_ID="uco8wbwq"
SANITY_ORG_ID="oh314dkvd"
SANITY_DATASET="production"
SANITY_API_TOKEN="your-sanity-server-api-token"

# Supabase / PostgreSQL (optionnel si Sanity est utilisé comme BD principale)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"

# Prestataire de paiement en ligne (désactivé par défaut tant que non configuré)
PAYMENT_PROVIDER="disabled"
PAYMENT_WEBHOOK_SECRET="your-webhook-hmac-secret"
PAYMENT_API_KEY="your-payment-provider-server-key"

# Sécurité des sessions et jetons de suivi de commande
SESSION_SECRET="replace-with-strong-32-byte-secret"
ORDER_TRACKING_HMAC_SECRET="replace-with-strong-order-tracking-secret"

# Clé API Gemini (optionnelle, côté serveur)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
